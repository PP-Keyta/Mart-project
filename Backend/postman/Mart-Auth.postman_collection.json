            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"' OR 1=1 --\",\n  \"password\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Token / session",
      "item": [
        {
          "name": "Detail - valid Bearer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200))",
                  "const j = pm.response.json()",
                  "pm.test(\"returns somchai\", () => { pm.expect(j.email).to.eql(\"somchai@example.com\"); pm.expect(j.login).to.eql(true) })"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "detail"
              ]
            }
          }
        },
        {
          "name": "Detail - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401))",
                  "pm.test(\"login is false\", () => pm.expect(pm.response.json().login).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "detail"
              ]
            }
          }
        },
        {
          "name": "Detail - tampered token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401))",
                  "pm.test(\"login is false\", () => pm.expect(pm.response.json().login).to.eql(false))"
                ]
