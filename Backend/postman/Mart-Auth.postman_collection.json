                "login"
              ]
            }
          }
        },
        {
          "name": "Login - SQL injection attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401))",
                  "pm.test(\"not logged in\", () => pm.expect(pm.response.json().login).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
