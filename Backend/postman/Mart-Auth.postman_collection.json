        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200))",
                  "pm.test(\"login is false\", () => pm.expect(pm.response.json().login).to.eql(false))",
                  "pm.test(\"clears cookie\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\") || \"\").to.include(\"token=;\"))"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
