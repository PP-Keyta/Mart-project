{
  "info": {
    "name": "Mart - Auth (members)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole collection (Collection Runner) with the backend running on {{baseUrl}}. Registers a new autotest_* account each run."
  },
  "item": [
    {
      "name": "1. Register",
      "item": [
        {
          "name": "Register - success (tries role=admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newEmail', 'autotest_' + Date.now() + '@example.com')"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201))",
                  "const j = pm.response.json()",
                  "pm.test(\"regist is true\", () => pm.expect(j.regist).to.eql(true))",
                  "pm.test(\"role is member (admin request ignored)\", () => pm.expect(j.role).to.eql(\"member\"))",
                  "pm.test(\"no password in response\", () => { pm.expect(j).to.not.have.property(\"password\"); pm.expect(j).to.not.have.property(\"password_hash\") })"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"name\": \"Auto Test\",\n  \"password\": \"12345678\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        },
        {
          "name": "Register - duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409))",
                  "pm.test(\"regist is false\", () => pm.expect(pm.response.json().regist).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"name\": \"Auto Test\",\n  \"password\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        },
        {
          "name": "Register - password too short",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400))",
                  "pm.test(\"regist is false\", () => pm.expect(pm.response.json().regist).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"short_pwd@example.com\",\n  \"name\": \"A\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        },
        {
          "name": "Register - missing fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400))",
                  "pm.test(\"regist is false\", () => pm.expect(pm.response.json().regist).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"missing@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login - success (somchai)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200))",
                  "const j = pm.response.json()",
                  "pm.test(\"login is true and has token\", () => { pm.expect(j.login).to.eql(true); pm.expect(j.token).to.be.a(\"string\") })",
                  "pm.test(\"member has id/email/role, no hash\", () => { pm.expect(j.member).to.include.keys(\"id\",\"email\",\"role\"); pm.expect(j.member).to.not.have.property(\"password_hash\") })",
                  "pm.test(\"sets httpOnly cookie\", () => { const c = pm.response.headers.get(\"Set-Cookie\") || \"\"; pm.expect(c).to.include(\"token=\"); pm.expect(c).to.include(\"HttpOnly\") })",
                  "pm.collectionVariables.set(\"token\", j.token)"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - newly registered account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200))",
                  "pm.test(\"login is true\", () => pm.expect(pm.response.json().login).to.eql(true))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401))",
                  "pm.test(\"login is false\", () => pm.expect(pm.response.json().login).to.eql(false))",
                  "pm.collectionVariables.set(\"failMsg\", pm.response.json().message)"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai@example.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - unknown email (same message as wrong password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401))",
                  "pm.test(\"same message as wrong password\", () => pm.expect(pm.response.json().message).to.eql(pm.collectionVariables.get(\"failMsg\")))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - missing fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400))",
                  "pm.test(\"login is false\", () => pm.expect(pm.response.json().login).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
